{
  "name": "taxino-landing",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "TAXINO — cinematic Persian landing page for the taxi agency management platform by Karen Soft",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "node server/index.mjs",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/build-assets.mjs",
    "qa": "node qa/run.mjs",
    "qa:audit": "node qa/audit.mjs",
    "qa:api": "node qa/api.mjs",
    "qa:lead": "node qa/lead.test.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "gsap": "^3.15.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  },
  "engines": {
    "node": ">=22.15"
  }
