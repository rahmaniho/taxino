# Where POST /api/consult stores accepted leads (JSONL, 0600).
# Defaults to ./var/leads — keep it outside the web root.
LEAD_DIR=./var/leads

# Optional: forward each accepted lead to a webhook (CRM, Telegram relay, …).
# When set, a lead is considered accepted if either the webhook or the file
# write succeeds. The form never reports a success that did not happen.
# LEAD_WEBHOOK_URL=https://example.com/hooks/taxino-leads

# Production server (npm start)
PORT=4173
HOST=0.0.0.0
